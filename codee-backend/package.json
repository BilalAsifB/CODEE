{
  "name": "codee",
  "version": "1.0.0",
  "description": "your coding buddy",
  "type": "module",
  "main": "src/server.js",
  "scripts": {
    "start": "node -r dotenv/config src/server.js",
    "dev": "nodemon -r dotenv/config src/server.js",
    "test": "DOTENV_CONFIG_PATH=.env.test NODE_OPTIONS=--experimental-vm-modules node -r dotenv/config ./node_modules/.bin/jest",
    "test:watch": "DOTENV_CONFIG_PATH=.env.test NODE_OPTIONS=--experimental-vm-modules node -r dotenv/config ./node_modules/.bin/jest --watch",
    "test:coverage": "DOTENV_CONFIG_PATH=.env.test NODE_OPTIONS=--experimental-vm-modules node -r dotenv/config ./node_modules/.bin/jest --coverage",
    "test:integration": "node tests.js"
  },
  "keywords": [],
  "author": "Bilal Asif Burney",
  "license": "ISC",
  "dependencies": {
    "axios": "^1.13.2",
    "cors": "^2.8.5",
    "dotenv": "^17.2.3",
    "express": "^5.1.0",
    "node-cache": "^5.1.2"
  },
  "devDependencies": {
    "@jest/globals": "^30.2.0",
    "jest": "^30.2.0",
    "nodemon": "^3.1.11",
    "prettier": "^3.7.3"
  },
  "jest": {
    "testEnvironment": "node",
    "transform": {},
    "testMatch": [
      "**/__tests__/**/*.test.js"
    ],
    "collectCoverageFrom": [
      "src/**/*.js",
      "!src/server.js"
    ]
  }
}
